# Used when running the backend on the host (`pnpm start` = node --max-old-space-size=150 dist/index.js)
# against the dependencies from `pnpm dev:deps`. Copy to .env and `set -a; source .env; set +a`.

# all | api | worker
APP_MODE=all
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DATABASE_URL=postgresql://guardian:guardian@localhost:15432/guardian?connection_limit=5
REDIS_URL=redis://localhost:16379

# Worker
TRIVY_BINARY=trivy
# Client/server mode: the vulnerability DB lives in the trivy-server container.
TRIVY_SERVER_URL=http://localhost:4954
SCAN_WORK_DIR=/tmp/code-guardian
MIN_FREE_BYTES=1073741824
WORKER_CONCURRENCY=1
CLONE_TIMEOUT_MS=120000
SCAN_TIMEOUT_MS=600000
BATCH_SIZE=500
