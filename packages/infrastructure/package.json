{
  "name": "@code-guardian/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "Adapters implementing @code-guardian/core ports (Trivy, git, Postgres, BullMQ, filesystem)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bench": "tsc -p tsconfig.scripts.json",
    "gen:report": "node dist/bench/scripts/generate-large-report.js",
    "bench:parse": "node --max-old-space-size=150 dist/bench/scripts/parse-benchmark.js",
    "bench:naive": "node --max-old-space-size=150 dist/bench/scripts/naive-parse.js"
  },
  "dependencies": {
    "@code-guardian/core": "workspace:*",
    "stream-chain": "^2.2.5",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/stream-chain": "^2.1.0",
    "@types/stream-json": "^1.7.8"
  }
}
